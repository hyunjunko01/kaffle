# App
DATABASE_URL=
APP_URL=
SESSION_SECRET=
# Comma-separated User.kakaoId values for /admin
ADMIN_KAKAO_IDS=

# Kakao — redirect must match Kakao console
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Web3Auth — PEM newlines as \n; JWKS at ${APP_URL}/.well-known/jwks.json
WEB3AUTH_JWT_PRIVATE_KEY=
WEB3AUTH_JWT_KID=
WEB3AUTH_JWT_ISSUER=
WEB3AUTH_JWT_AUDIENCE=
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
NEXT_PUBLIC_WEB3AUTH_AUTH_CONNECTION_ID=
# sapphire_devnet | sapphire_mainnet
NEXT_PUBLIC_WEB3AUTH_NETWORK=

# Chain — CHAIN and NEXT_PUBLIC_CHAIN must match
# anvil | sepolia | base-sepolia | base
CHAIN=
NEXT_PUBLIC_CHAIN=
# Browser-visible RPC (prefer public URL; keep Alchemy keys on server RPC below)
NEXT_PUBLIC_RPC_URL=

# Anvil
ANVIL_RPC_URL=
ANVIL_OWNER_PRIVATE_KEY=
ANVIL_RELAYER_PRIVATE_KEY=
ANVIL_TICKET_SIGNER_PRIVATE_KEY=
ANVIL_KAFFLE_FACTORY=
ANVIL_KAFFLE_VAULT=
ANVIL_KAFFLE_FAUCET=
ANVIL_KAFFLE_IMPLEMENTATION=
ANVIL_PRIZE_TOKEN=
ANVIL_VRF_COORDINATOR=

# Ethereum Sepolia
SEPOLIA_RPC_URL=
SEPOLIA_KAFFLE_FACTORY=
SEPOLIA_KAFFLE_VAULT=
SEPOLIA_KAFFLE_FAUCET=
SEPOLIA_KAFFLE_IMPLEMENTATION=
SEPOLIA_PRIZE_TOKEN=
SEPOLIA_VRF_COORDINATOR=
SEPOLIA_OWNER_PRIVATE_KEY=
SEPOLIA_RELAYER_PRIVATE_KEY=
SEPOLIA_TICKET_SIGNER_PRIVATE_KEY=

# Base Sepolia
BASE_SEPOLIA_RPC_URL=
BASE_SEPOLIA_KAFFLE_FACTORY=
BASE_SEPOLIA_KAFFLE_VAULT=
BASE_SEPOLIA_KAFFLE_FAUCET=
BASE_SEPOLIA_KAFFLE_IMPLEMENTATION=
BASE_SEPOLIA_PRIZE_TOKEN=
BASE_SEPOLIA_VRF_COORDINATOR=
BASE_SEPOLIA_OWNER_PRIVATE_KEY=
BASE_SEPOLIA_RELAYER_PRIVATE_KEY=
