# Neon / Postgres connection string (not sqlite).
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Public app URL. Local: http://localhost:3000 — Vercel: https://YOUR_PROJECT.vercel.app
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"
ADMIN_SECRET="replace-with-an-admin-password"

KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""
# Must match Kakao console Redirect URI (add the Vercel callback too when deploying).
KAKAO_REDIRECT_URI="http://localhost:3000/auth/kakao/callback"

# PKCS8 PEM. Replace newlines with \n
# openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
# Web3Auth dashboard JWKS URL: ${APP_URL}/.well-known/jwks.json
WEB3AUTH_JWT_PRIVATE_KEY=""
WEB3AUTH_JWT_KID="kaffle-1"
# On Vercel set these to the same public APP_URL.
WEB3AUTH_JWT_ISSUER="http://localhost:3000"
WEB3AUTH_JWT_AUDIENCE="kaffle"

NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=""
NEXT_PUBLIC_WEB3AUTH_AUTH_CONNECTION_ID=""
NEXT_PUBLIC_WEB3AUTH_NETWORK="sapphire_devnet"

# Active chain. Keep CHAIN and NEXT_PUBLIC_CHAIN the same.
# Deploy / friend-invite testing: use base-sepolia
# anvil | sepolia | base-sepolia
CHAIN=base-sepolia
NEXT_PUBLIC_CHAIN=base-sepolia
# Wallet / Web3Auth RPC for the active chain (browser-visible).
NEXT_PUBLIC_RPC_URL="https://sepolia.base.org"

# Anvil (31337) — local only
ANVIL_RPC_URL="http://127.0.0.1:8545"
ANVIL_OWNER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
