generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String              @id @default(cuid())
  kakaoId                   String              @unique
  nickname                  String
  nicknameChangeCount       Int                 @default(0)
  postSignupNicknameChanged Boolean             @default(false)
  referralCode              String              @unique
  referredByUserId          String?
  createdAt                 DateTime            @default(now())
  wallet                    Wallet?
  referredBy                User?               @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals                 User[]              @relation("Referrals")
  ticketLedger              TicketLedger[]
  missionCompletions        MissionCompletion[]
}

model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  address String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TicketLedger {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  relatedId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MissionCompletion {
  id        String   @id @default(cuid())
  userId    String
  mission   String
  status    String
  extra     String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mission, extra])
}

model RaffleSnapshot {
  id            String       @id @default(cuid())
  raffleAddress String       @unique
  roundNumber   Int
  winnerAddress String?
  prizeAmount   String
  prizeClaimed  Boolean      @default(false)
  symbol        String
  tokenDecimals Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  claims        PrizeClaim[]

  @@index([roundNumber])
}

model PrizeClaim {
  id            String         @id @default(cuid())
  raffleAddress String
  winnerAddress String
  amountWei     String
  txHash        String         @unique
  claimedAt     DateTime       @default(now())
  raffle        RaffleSnapshot @relation(fields: [raffleAddress], references: [raffleAddress], onDelete: Cascade)

  @@index([winnerAddress])
}
