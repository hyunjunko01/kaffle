generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(cuid())
  kakaoId                   String                     @unique
  nickname                  String
  nicknameChangeCount       Int                        @default(0)
  postSignupNicknameChanged Boolean                    @default(false)
  referralCode              String                     @unique
  referredByUserId          String?
  createdAt                 DateTime                   @default(now())
  wallet                    Wallet?
  personalWallet            PersonalWallet?
  walletOwnershipChallenges WalletOwnershipChallenge[]
  referredBy                User?                      @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals                 User[]                     @relation("Referrals")
  raffleEntryOperations     RaffleEntryOperation[]
  ticketLedger              TicketLedger[]
  missionCompletions        MissionCompletion[]
}

model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  address String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * User-owned external wallet (e.g. MetaMask), proven via signed challenge.
 */
model PersonalWallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  address    String   @unique
  verifiedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletOwnershipChallenge {
  id        String    @id @default(cuid())
  userId    String
  address   String
  nonce     String    @unique
  message   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, address])
}

model TicketLedger {
  id               String                @id @default(cuid())
  userId           String
  amount           Int
  reason           String
  relatedId        String?
  createdAt        DateTime              @default(now())
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryOperationId String?
  entryOperation   RaffleEntryOperation? @relation(fields: [entryOperationId], references: [id], onDelete: Restrict)

  @@unique([entryOperationId, reason])
}

enum RaffleEntryState {
  PREPARING
  PENDING
  CONFIRMED
  FAILED
}

// The SQL migration also enforces a partial unique live-voucher nonce index.
model RaffleEntryOperation {
  id              String           @id @default(cuid())
  userId          String
  requestId       String
  chainId         Int
  raffleAddress   String
  walletAddress   String
  ticketCount     Int
  entryNonce      String?
  deadline        BigInt?
  startBlock      BigInt?
  scanBlock       BigInt?
  confirmedTxHash String?
  state           RaffleEntryState @default(PREPARING)
  txHash          String?          @unique
  rawTransaction  String?
  leaseOwner      String?
  leaseUntil      DateTime?
  failureReason   String?
  lastCheckedAt   DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  ledger          TicketLedger[]

  @@unique([userId, requestId])
  @@index([chainId, state, lastCheckedAt])
}

model MissionCompletion {
  id        String   @id @default(cuid())
  userId    String
  mission   String
  status    String
  extra     String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mission, extra])
}

model RaffleSnapshot {
  id            String       @id @default(cuid())
  raffleAddress String       @unique
  roundNumber   Int
  winnerAddress String?
  prizeAmount   String
  prizeClaimed  Boolean      @default(false)
  symbol        String
  tokenDecimals Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  claims        PrizeClaim[]

  @@index([roundNumber])
}

model PrizeClaim {
  id            String         @id @default(cuid())
  raffleAddress String
  winnerAddress String
  amountWei     String
  txHash        String         @unique
  claimedAt     DateTime       @default(now())
  raffle        RaffleSnapshot @relation(fields: [raffleAddress], references: [raffleAddress], onDelete: Cascade)

  @@index([winnerAddress])
}
